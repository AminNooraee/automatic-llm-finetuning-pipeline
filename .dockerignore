# Default-deny build context: send only the files required for this image.
# Keep this file at the repository root, even with -f docker/Dockerfile.
**
!.dockerignore
!.gitlab-ci.yml
!README.md
!LICENSE
!pyproject.toml
!requirements.txt
!docker/
docker/**
!docker/Dockerfile
!docker/Dockerfile.controller
!docker/Dockerfile.host-dns
!docker/Dockerfile.controller.host-dns
!docker/pytorch-requirements.txt
!docker/install-training-dependencies.sh
!src/
src/**
!src/fine_tuning_pipeline/
src/fine_tuning_pipeline/**
!src/fine_tuning_pipeline/*.py
!src/fine_tuning_pipeline/dataset_adapters/
src/fine_tuning_pipeline/dataset_adapters/**
!src/fine_tuning_pipeline/dataset_adapters/*.py
!src/fine_tuning_pipeline/serving/
src/fine_tuning_pipeline/serving/**
!src/fine_tuning_pipeline/serving/*.py
!src/fine_tuning_pipeline/serving/backends/
src/fine_tuning_pipeline/serving/backends/**
!src/fine_tuning_pipeline/serving/backends/*.py
!src/fine_tuning_pipeline/gateway/
src/fine_tuning_pipeline/gateway/**
!src/fine_tuning_pipeline/gateway/*.py
!src/fine_tuning_pipeline/gateway/providers/
src/fine_tuning_pipeline/gateway/providers/**
!src/fine_tuning_pipeline/gateway/providers/*.py
!src/fine_tuning_pipeline/orchestration/
src/fine_tuning_pipeline/orchestration/**
!src/fine_tuning_pipeline/orchestration/*.py
!configs/
configs/**
!configs/config.yaml
!configs/qwen_example.yaml
!configs/llama_example.yaml
!configs/huggingface_dataset_example.yaml
!configs/serving_gateway_example.yaml
!configs/full_pipeline_example.yaml
!configs/ci_phase1.yaml
!configs/model_catalog.yaml
!configs/ci_infrastructure.yaml
!examples/
examples/**
!examples/datasets/
examples/datasets/**
!examples/datasets/alpaca_demo.json
!examples/datasets/rag_qa.json
!examples/datasets/openai_chat.json
!tests/
tests/**
!tests/*.py
!scripts/
scripts/**
!scripts/*.sh
!scripts/prepare_ci_job.py
!scripts/validate_prepared_train.py

# Final exclusions also protect files nested within an allowed source directory.
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
**/tmp*
**/.git
**/.env
**/.env.*
**/*.local.yaml
**/*.local.yml
**/*.pem
**/*.key
**/*.log
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.ckpt
