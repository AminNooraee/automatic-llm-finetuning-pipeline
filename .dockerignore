# Default-deny build context: send only the files required for this image.
# Keep this file at the repository root, even with -f docker/Dockerfile.
**
!.dockerignore
!README.md
!LICENSE
!pyproject.toml
!requirements.txt
!docker/
docker/**
!docker/Dockerfile
!docker/pytorch-requirements.txt
!src/
src/**
!src/fine_tuning_pipeline/
src/fine_tuning_pipeline/**
!src/fine_tuning_pipeline/*.py
!src/fine_tuning_pipeline/dataset_adapters/
src/fine_tuning_pipeline/dataset_adapters/**
!src/fine_tuning_pipeline/dataset_adapters/*.py
!configs/
configs/**
!configs/config.yaml
!configs/qwen_example.yaml
!configs/llama_example.yaml
!configs/huggingface_dataset_example.yaml
!examples/
examples/**
!examples/datasets/
examples/datasets/**
!examples/datasets/alpaca_demo.json
!examples/datasets/rag_qa.json
!examples/datasets/openai_chat.json
!tests/
tests/**
!tests/*.py

# Final exclusions also protect files nested within an allowed source directory.
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
**/tmp*
**/.git
**/.env
**/.env.*
**/*.local.yaml
**/*.local.yml
**/*.pem
**/*.key
**/*.log
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.ckpt
