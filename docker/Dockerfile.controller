# syntax=docker/dockerfile:1
ARG CONTROLLER_IMAGE=python:3.12.7-slim-bookworm@sha256:60d9996b6a8a3689d36db740b49f4327be3be09a21122bd02fb8895abb38b50d
FROM ${CONTROLLER_IMAGE}

ARG PIPELINE_BUILD_DNS=
ARG SOURCE_REVISION=unknown
ARG SOURCE_IDENTITY=unknown
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      fine-tuning-pipeline.source-identity=${SOURCE_IDENTITY} \
      fine-tuning-pipeline.image-role=controller

COPY docker/configure-build-dns.sh /usr/local/bin/configure-build-dns
RUN /bin/sh /usr/local/bin/configure-build-dns "$PIPELINE_BUILD_DNS" \
    /bin/sh -c 'apt-get update \
        && apt-get install -y --no-install-recommends ca-certificates docker.io tini \
        && rm -rf /var/lib/apt/lists/*'

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY README.md LICENSE pyproject.toml ./
COPY src/fine_tuning_pipeline/ ./src/fine_tuning_pipeline/
RUN /bin/sh /usr/local/bin/configure-build-dns "$PIPELINE_BUILD_DNS" \
    /bin/sh -c 'python -m pip install --no-cache-dir . \
        && python -m compileall -q /app/src'

ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["python", "-m", "fine_tuning_pipeline.orchestration.controller"]
